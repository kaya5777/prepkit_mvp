<%# 相性診断セクション %>
<div class="mb-8 bg-white rounded-xl shadow-sm border border-secondary-200 overflow-hidden">
  <div class="bg-gradient-to-r from-purple-50 to-indigo-50 px-6 py-4 border-b border-secondary-200">
    <div class="flex items-center justify-between">
      <h2 class="text-xl font-bold text-secondary-900 flex items-center gap-2">
        <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
        </svg>
        相性診断
      </h2>
      <% if history.match_analyzed? %>
        <%= button_to analyze_match_history_path(history), method: :post, class: "text-sm text-purple-600 hover:text-purple-700 font-medium", data: { turbo: false }, form: { onsubmit: "showMatchAnalysisModal(); return true;" } do %>
          再診断
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="p-6">
    <% if history.match_analyzed_openai? || history.match_analyzed_gemini? %>
      <!-- AI予測の注意書き -->
      <div class="mb-6 p-4 bg-blue-50 border border-blue-200 rounded-lg">
        <div class="flex items-start gap-2">
          <svg class="w-5 h-5 text-blue-600 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
          </svg>
          <p class="text-sm text-blue-700">
            この診断はAIによる予測です。実際の採用判断は企業や状況によって異なります。参考情報としてご活用ください。
          </p>
        </div>
      </div>

      <!-- タブレイアウト: OpenAI と Gemini -->
      <div class="mb-6">
        <!-- タブヘッダー -->
        <div class="flex border-b border-secondary-200 mb-6">
          <button type="button" onclick="switchMatchTab('openai')" id="match-tab-openai" class="match-tab-button px-6 py-3 font-medium text-sm transition-colors border-b-2 border-green-500 text-green-700">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path d="M10 2a8 8 0 100 16 8 8 0 000-16zm1 11H9v-2h2v2zm0-4H9V5h2v4z"/>
              </svg>
              OpenAI (gpt-4o-mini)
            </div>
          </button>
          <button type="button" onclick="switchMatchTab('gemini')" id="match-tab-gemini" class="match-tab-button px-6 py-3 font-medium text-sm transition-colors border-b-2 border-transparent text-secondary-500 hover:text-secondary-700">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path d="M10 2a8 8 0 100 16 8 8 0 000-16zm1 11H9v-2h2v2zm0-4H9V5h2v4z"/>
              </svg>
              Google Gemini (gemini-2.5-flash)
            </div>
          </button>
        </div>

        <!-- OpenAI の分析結果 -->
        <div id="match-content-openai" class="match-tab-content space-y-6">
          <% if history.match_analyzed_openai? %>
            <!-- スコア表示 -->
            <div class="bg-white rounded-xl border-2 border-green-200 p-6 text-center">
              <div class="text-sm text-secondary-600 mb-2">マッチ度</div>
              <div class="text-5xl font-bold text-green-600 mb-2"><%= history.match_score_openai %></div>
              <div class="text-2xl font-bold text-green-700"><%= history.match_rank_openai %> ランク</div>
            </div>

            <!-- マッチングポイント -->
            <% if history.matching_points_openai.any? %>
              <div class="bg-green-50 rounded-xl p-4">
                <h4 class="font-bold text-secondary-900 mb-3 flex items-center gap-2">
                  <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
                  マッチングポイント
                </h4>
                <ul class="space-y-3">
                  <% history.matching_points_openai.each do |point| %>
                    <li class="text-sm text-secondary-700">
                      <div class="flex items-start gap-2 mb-1">
                        <span class="text-green-500 mt-0.5">✓</span>
                        <strong><%= point["requirement"] %></strong>
                      </div>
                      <% if point["experience"].present? %>
                        <div class="ml-6 text-xs text-secondary-600 mb-1">経験: <%= point["experience"] %></div>
                      <% end %>
                      <% if point["strength"].present? %>
                        <div class="ml-6 text-xs text-green-700">強み: <%= point["strength"] %></div>
                      <% end %>
                    </li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <!-- 懸念事項 -->
            <% if history.concerns_openai.any? %>
              <div class="bg-amber-50 rounded-xl p-4">
                <h4 class="font-bold text-secondary-900 mb-3 flex items-center gap-2">
                  <svg class="w-5 h-5 text-amber-600" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                  </svg>
                  懸念事項
                </h4>
                <ul class="space-y-2">
                  <% history.concerns_openai.each do |concern| %>
                    <li class="flex items-start gap-2 text-sm text-secondary-700">
                      <span class="text-amber-500 mt-0.5">⚠</span>
                      <%= concern %>
                    </li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <!-- アドバイス -->
            <% if history.advice_openai.present? %>
              <div class="bg-blue-50 rounded-xl p-4">
                <h4 class="font-bold text-secondary-900 mb-3 flex items-center gap-2">
                  <svg class="w-5 h-5 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                  </svg>
                  アドバイス
                </h4>
                <p class="text-sm text-secondary-700 whitespace-pre-wrap"><%= history.advice_openai %></p>
              </div>
            <% end %>
          <% else %>
            <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-center">
              <p class="text-sm text-amber-700">OpenAI の分析結果がありません</p>
            </div>
          <% end %>
        </div>

        <!-- Gemini の分析結果 -->
        <div id="match-content-gemini" class="match-tab-content space-y-6 hidden">
          <% if history.match_analyzed_gemini? %>
            <!-- スコア表示 -->
            <div class="bg-white rounded-xl border-2 border-blue-200 p-6 text-center">
              <div class="text-sm text-secondary-600 mb-2">マッチ度</div>
              <div class="text-5xl font-bold text-blue-600 mb-2"><%= history.match_score_gemini %></div>
              <div class="text-2xl font-bold text-blue-700"><%= history.match_rank_gemini %> ランク</div>
            </div>

            <!-- マッチングポイント -->
            <% if history.matching_points_gemini.any? %>
              <div class="bg-blue-50 rounded-xl p-4">
                <h4 class="font-bold text-secondary-900 mb-3 flex items-center gap-2">
                  <svg class="w-5 h-5 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
                  マッチングポイント
                </h4>
                <ul class="space-y-3">
                  <% history.matching_points_gemini.each do |point| %>
                    <li class="text-sm text-secondary-700">
                      <div class="flex items-start gap-2 mb-1">
                        <span class="text-blue-500 mt-0.5">✓</span>
                        <strong><%= point["requirement"] %></strong>
                      </div>
                      <% if point["experience"].present? %>
                        <div class="ml-6 text-xs text-secondary-600 mb-1">経験: <%= point["experience"] %></div>
                      <% end %>
                      <% if point["strength"].present? %>
                        <div class="ml-6 text-xs text-blue-700">強み: <%= point["strength"] %></div>
                      <% end %>
                    </li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <!-- 懸念事項 -->
            <% if history.concerns_gemini.any? %>
              <div class="bg-amber-50 rounded-xl p-4">
                <h4 class="font-bold text-secondary-900 mb-3 flex items-center gap-2">
                  <svg class="w-5 h-5 text-amber-600" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                  </svg>
                  懸念事項
                </h4>
                <ul class="space-y-2">
                  <% history.concerns_gemini.each do |concern| %>
                    <li class="flex items-start gap-2 text-sm text-secondary-700">
                      <span class="text-amber-500 mt-0.5">⚠</span>
                      <%= concern %>
                    </li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <!-- アドバイス -->
            <% if history.advice_gemini.present? %>
              <div class="bg-purple-50 rounded-xl p-4">
                <h4 class="font-bold text-secondary-900 mb-3 flex items-center gap-2">
                  <svg class="w-5 h-5 text-purple-600" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                  </svg>
                  アドバイス
                </h4>
                <p class="text-sm text-secondary-700 whitespace-pre-wrap"><%= history.advice_gemini %></p>
              </div>
            <% end %>
          <% else %>
            <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-center">
              <p class="text-sm text-amber-700">Gemini の分析結果がありません</p>
            </div>
          <% end %>
        </div>
      </div>

    <% else %>
      <!-- 未診断状態 -->
      <div class="text-center py-12">
        <% if current_user&.resumes&.analyzed&.exists? %>
          <div class="mb-6">
            <svg class="w-16 h-16 mx-auto text-purple-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
            </svg>
            <p class="text-lg text-secondary-700 mb-6">この求人とあなたの職務経歴書の相性を診断します</p>
          </div>
          <form method="post" action="<%= analyze_match_history_path(history) %>" data-turbo="false" onsubmit="showMatchAnalysisModal()">
            <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
            <button type="submit" style="background: linear-gradient(to right, rgb(168, 85, 247), rgb(147, 51, 234)); color: white; border: none; padding: 0.75rem 1.5rem; border-radius: 0.75rem; font-weight: bold; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);">
              <svg style="width: 1.25rem; height: 1.25rem; margin-right: 0.5rem; color: white;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span style="color: white;">相性診断を実行</span>
            </button>
          </form>
        <% else %>
          <div class="mb-6">
            <svg class="w-16 h-16 mx-auto text-amber-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <p class="text-lg text-secondary-700 mb-4">相性診断を行うには職務経歴書を登録してください</p>
          </div>
          <%= link_to new_resume_path, class: "inline-flex items-center justify-center px-6 py-3 bg-gradient-to-r from-primary-500 to-primary-600 hover:from-primary-600 hover:to-primary-700 text-white font-bold rounded-xl transition-all elevation-2 hover:elevation-3" do %>
            <svg class="w-5 h-5 mr-2 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            <span class="text-white">職務経歴書を登録</span>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<script>
function switchMatchTab(provider) {
  const tabs = document.querySelectorAll('.match-tab-button');
  const contents = document.querySelectorAll('.match-tab-content');

  // Reset all tabs to inactive state
  tabs.forEach(tab => {
    tab.classList.remove('border-green-500', 'border-blue-500', 'text-green-700', 'text-blue-700');
    tab.classList.add('border-transparent', 'text-secondary-500');
  });

  // Hide all content
  contents.forEach(content => content.classList.add('hidden'));

  // Activate selected tab
  const selectedTab = document.getElementById('match-tab-' + provider);
  const selectedContent = document.getElementById('match-content-' + provider);

  if (provider === 'openai') {
    selectedTab.classList.remove('border-transparent', 'text-secondary-500');
    selectedTab.classList.add('border-green-500', 'text-green-700');
  } else {
    selectedTab.classList.remove('border-transparent', 'text-secondary-500');
    selectedTab.classList.add('border-blue-500', 'text-blue-700');
  }

  selectedContent.classList.remove('hidden');
}

function showMatchAnalysisModal() {
  const modal = document.getElementById('matchAnalysisModal');
  if (modal) {
    modal.classList.remove('hidden');
  }
}
</script>

<!-- 相性診断実行中モーダル -->
<div id="matchAnalysisModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl elevation-4 max-w-md w-full p-8 text-center">
    <div class="w-20 h-20 bg-purple-100 rounded-full flex items-center justify-center mx-auto mb-6">
      <svg class="w-10 h-10 text-purple-600 animate-spin" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
    </div>
    <h3 class="text-2xl font-bold text-secondary-900 mb-3">相性診断を実行中</h3>
    <p class="text-secondary-600 mb-4">
      OpenAI と Gemini で分析しています...<br>
      <span class="text-sm">この処理には1〜2分程度かかります</span>
    </p>
    <div class="flex items-center justify-center gap-2 text-sm text-secondary-500">
      <div class="w-2 h-2 bg-purple-500 rounded-full animate-bounce" style="animation-delay: 0s"></div>
      <div class="w-2 h-2 bg-purple-500 rounded-full animate-bounce" style="animation-delay: 0.2s"></div>
      <div class="w-2 h-2 bg-purple-500 rounded-full animate-bounce" style="animation-delay: 0.4s"></div>
    </div>
  </div>
</div>
